// ------------------------------------------------------------------------------------------------
// Функция _ПолучитьСловарь
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Формує та повертає вбудований словник відмінювання.
//   Словник містить розділи: незмінні слова, чоловічі/жіночі імена,
//   виключення та словникові записи для особливих форм.
//
// Параметри:
//   Немає
//
// Повертає:
//   Соответствие – словник у форматі НазваСекції → Соответствие(слово → Истина).
// ------------------------------------------------------------------------------------------------
Функция _ПолучитьСловарь()


	// Вбудований словник (формат INI: [Секція] / слово ; коментар)
	ТекстСловаря =
	"; Слова що не відмінюються взагалі (усі відмінки = Називний)" + Символы.ПС +
	"[Незмінні]" + Символы.ПС +
	"; Незмінні слова в посадах" + Символы.ПС +
	"авто" + Символы.ПС +
	"авіа" + Символы.ПС +
	"ательє" + Символы.ПС +
	"бюро" + Символы.ПС +
	"депо" + Символы.ПС +
	"кіно" + Символы.ПС +
	"метро" + Символы.ПС +
	"ревю" + Символы.ПС +
	"соло" + Символы.ПС +
	"табло" + Символы.ПС +
	"какао" + Символы.ПС +
	"радіо" + Символы.ПС +
	"відео" + Символы.ПС +
	"" + Символы.ПС +
	"; Чоловічі імена що закінчуються на -а або -я (1-а відміна, чоловічий рід)" + Символы.ПС +
	"[ЧоловічіІмена]" + Символы.ПС +
	"микола" + Символы.ПС +
	"сава" + Символы.ПС +
	"ілля" + Символы.ПС +
	"лука" + Символы.ПС +
	"хома" + Символы.ПС +
	"юда" + Символы.ПС +
	"" + Символы.ПС +
	"; Жіночі імена що закінчуються на приголосну (3-я відміна, жіночий рід)" + Символы.ПС +
	"[ЖіночіІмена]" + Символы.ПС +
	"любов" + Символы.ПС +
	"нінель" + Символы.ПС +
	"" + Символы.ПС +
	"; Слова де у 2-й відміні закінчення -і (не -и) у Родовому: Ніна → Ніни" + Символы.ПС +
	"[Відмінювання2ВключаєЗакінченняНА]" + Символы.ПС +
	"ніна" + Символы.ПС +
	"зіна" + Символы.ПС +
	"діна" + Символы.ПС +
	"" + Символы.ПС +
	"; Слова-виключення для відмінювання посад - незмінні частини" + Символы.ПС +
	"[НезмінніЧастиниСлів]" + Символы.ПС +
	"біла" + Символы.ПС +
	"мала" + Символы.ПС +
	"нова" + Символы.ПС +
	"старо" + Символы.ПС +
	"ново" + Символы.ПС +
	"велико" + Символы.ПС +
	"дніпро" + Символы.ПС +
	"" + Символы.ПС +
	"; Незмінні прийменники та сполучники у посадах" + Символы.ПС +
	"[НезмінніСловаДляПосад]" + Символы.ПС +
	"та" + Символы.ПС +
	"і" + Символы.ПС +
	"й" + Символы.ПС +
	"або" + Символы.ПС +
	"за" + Символы.ПС +
	"із" + Символы.ПС +
	"від" + Символы.ПС +
	"до" + Символы.ПС +
	"через" + Символы.ПС +
	"при" + Символы.ПС +
	"по" + Символы.ПС +
	"на" + Символы.ПС +
	"з" + Символы.ПС +
	"у" + Символы.ПС +
	"в" + Символы.ПС +
	"без" + Символы.ПС +
	"де" + Символы.ПС +
	"для" + Символы.ПС +
	"над" + Символы.ПС +
	"під" + Символы.ПС +
	"" + Символы.ПС +
	"; Виключення - слова що відмінюються особливим чином" + Символы.ПС +
	"[Виключення]" + Символы.ПС +
	"господь" + Символы.ПС +
	"" + Символы.ПС +
	"; Слова у посадах де велика літера закінчення залишається великою" + Символы.ПС +
	"[ПершаЛітераЗВеликої]" + Символы.ПС +
	"біла" + Символы.ПС +
	"рівне" + Символы.ПС +
	"луцьк" + Символы.ПС +
	"";

	Словарь = Новый Соответствие;

	ПоточнаСекція = "";
	ПоточнийСписок = Неопределено;

	МасивРядків = СтрРазделить(ТекстСловаря, Символы.ПС, Ложь);

	Для Каждого Рядок Из МасивРядків Цикл
		// Відрізаємо коментар після ";"
		ПозКом = СтрНайти(Рядок, ";");
		Если ПозКом > 0 Тогда
			Рядок = Лев(Рядок, ПозКом - 1);
		КонецЕсли;
		Рядок = СокрЛП(Рядок);

		Если ПустаяСтрока(Рядок) Тогда
			Продолжить;
		КонецЕсли;

		// Обробка заголовку секції [СекціяНазва]
		Если Лев(Рядок, 1) = "[" И Прав(Рядок, 1) = "]" Тогда
			ПоточнаСекція = НРег(Сред(Рядок, 2, СтрДлина(Рядок) - 2));
			Если ПустаяСтрока(ПоточнаСекція) Тогда
				Продолжить;
			КонецЕсли;
			ПоточнийСписок = Новый Соответствие;
			Словарь.Вставить(ПоточнаСекція, ПоточнийСписок);
			Продолжить;
		КонецЕсли;

		Если ПоточнийСписок = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Додаємо слово до поточної секції
		Слово = НРег(СокрЛП(Рядок));
		Если НЕ ПустаяСтрока(Слово) Тогда
			ПоточнийСписок.Вставить(Слово, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Словарь;

КонецФункции

