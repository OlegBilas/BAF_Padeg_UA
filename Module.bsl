// ------------------------------------------------------------------------------------------------
// Функция _НормализоватьСлово
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Замінює латинські символи-двійники (що виглядають як кириличні) на кириличні.
//   Наприклад: латинська "i" → українська "і".
//
// Параметри:
//   Слово (Строка) – вхідне слово.
//
// Повертає:
//   Строка – нормалізоване слово лише з кириличними символами.
// ------------------------------------------------------------------------------------------------
Функция _НормализоватьСлово(Слово)

	Результат = Слово;
	// Таблиця заміни: латинські символи → кирилиця
	// (символи що візуально схожі можуть потрапити з clipboard або OCR)
	Замены = Новый Массив;
	Замены.Добавить("i|і"); // латинська i → кирилична і
	Замены.Добавить("I|І"); // латинська I → кирилична І
	Замены.Добавить("o|о"); // латинська o → кирилична о
	Замены.Добавить("O|О"); // латинська O → кирилична О
	Замены.Добавить("p|р"); // латинська p → кирилична р
	Замены.Добавить("P|Р"); // латинська P → кирилична Р
	Замены.Добавить("a|а"); // латинська a → кирилична а
	Замены.Добавить("A|А"); // латинська A → кирилична А
	Замены.Добавить("e|е"); // латинська e → кирилична е
	Замены.Добавить("E|Е"); // латинська E → кирилична Е
	Замены.Добавить("x|х"); // латинська x → кирилична х
	Замены.Добавить("X|Х"); // латинська X → кирилична Х
	Замены.Добавить("c|с"); // латинська c → кирилична с
	Замены.Добавить("C|С"); // латинська C → кирилична С
	Замены.Добавить("B|В"); // латинська B → кирилична В
	Замены.Добавить("M|М"); // латинська M → кирилична М
	Замены.Добавить("H|Н"); // латинська H → кирилична Н
	Замены.Добавить("K|К"); // латинська K → кирилична К
	Замены.Добавить("T|Т"); // латинська T → кирилична Т
	Замены.Добавить("y|у"); // латинська y → кирилична у

	Для Каждого ПараЗаміни Из Замены Цикл
		Позиция = СтрНайти(ПараЗаміни, "|");
		Если Позиция > 0 Тогда
			Лат  = Лев(ПараЗаміни, Позиция - 1);
			Кир  = Сред(ПараЗаміни, Позиция + 1);
			Результат = СтрЗаменить(Результат, Лат, Кир);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция _ОпределитьОкончание
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Виділяє голосне закінчення слова (одне або кілька трейлінгових голосних).
//   Встановлює основу слова (без закінчення).
//
// Параметри:
//   Слово      (Строка)     – слово в нижньому регістрі.
//   Основа     (Строка)     – [out] основа слова без голосного закінчення.
//
// Повертає:
//   Строка – голосне закінчення (може бути "" якщо слово закінчується на приголосну).
//
// Особливості:
//   М'який знак "ь" вважається частиною закінчення і входить до результату.
// ------------------------------------------------------------------------------------------------
Функция _ОпределитьОкончание(Слово, Основа)

	Довжина = СтрДлина(Слово);
	Закінчення = "";
	Основа = "";

	// Ітеруємо символи з кінця
	i = Довжина;
	Пока i >0 Цикл
		Буква = Сред(Слово, i, 1);
		Если _ЯвляетсяГласной(Буква) Тогда
			Закінчення = Буква + Закінчення;
		Иначе
			Прервать;
		КонецЕсли;
		i = i - 1;
	КонецЦикла;

	Основа = Лев(Слово, Довжина - СтрДлина(Закінчення));
	Возврат Закінчення;

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция _СохранитьРегистр
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відновлює оригінальний регістр слова у результаті відмінювання.
//   Якщо вхідне слово починалось з великої літери - результат теж починатиметься.
//   Якщо вхідне слово було цілком у верхньому регістрі - результат теж.
//
// Параметри:
//   Исходное  (Строка) – оригінальне слово (з яким порівнюємо регістр).
//   Результат (Строка) – відмінена форма у нижньому регістрі.
//
// Повертає:
//   Строка – результат з відновленим регістром.
// ------------------------------------------------------------------------------------------------
Функция _СохранитьРегистр(Исходное, Результат)

	Если СтрДлина(Исходное) = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если Исходное = ВРег(Исходное) Тогда
		// Повністю великими
		Возврат ВРег(Результат);
	ИначеЕсли Лев(Исходное, 1) = ВРег(Лев(Исходное, 1)) Тогда
		// Перша літера велика
		Если СтрДлина(Результат) > 0 Тогда
			Возврат ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОсновнойАлгоритмСклонения

// ------------------------------------------------------------------------------------------------
// Функция _ПолучитьСлово
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює одне слово по заданому відмінку та статі.
//   Ядро алгоритму відмінювання: визначає відміну, рід, основу та застосовує закінчення.
//
// Параметри:
//   Слово          (Строка) – вхідне слово (будь-який регістр).
//   Пол            (Строка) – стать: "М"/"Ч" - чоловічий, "Ж" - жіночий, "" - авто.
//   Падеж          (Число)  – номер відмінка 1..7.
//   Язык           (Строка) – мова (зараз підтримується тільки "UA").
//   ТипСлова       (Строка) – тип: "Фамилия" = прізвище, "Имя" = ім'я, "Отчество" = по-батькові, "Должность" = посада.
//   ПідказкаРід    (Строка) – підказка роду: "" = авто, "Ч" = чоловічий, "Ж" = жіночий.
//   ПідказкаТип    (Строка) – підказка типу відміни (зазвичай "").
//
// Повертає:
//   Строка – слово у потрібному відмінку.
//
// Виключення:
//   Не генерує. При невизначеній формі повертає вхідне слово без змін.
//
// Особливості:
//   - Обробляє складні слова (через дефіс, через пробіл).
//   - Не відмінює абревіатури (слова повністю у верхньому регістрі).
//   - Використовує вбудований словник для виключень.
//   - Зберігає оригінальний регістр у результаті.
// ------------------------------------------------------------------------------------------------
Функция _ПолучитьСлово(Слово, Пол, Падеж, Язык = "UA", ТипСлова = "", ПідказкаРід = "", ПідказкаТип = "")

	// --- 1. Нормалізація ---
	Слово = _НормализоватьСлово(Слово);

	Если ПустаяСтрока(Слово) Тогда
		Возврат Слово;
	КонецЕсли;

	// --- 2. Одна літера - не відмінюємо ---
	Если СтрДлина(СокрЛП(Слово)) <= 1 Тогда
		Возврат Слово;
	КонецЕсли;

	// --- 3. Абревіатура (все у верхньому регістрі) - не відмінюємо ---
	Если СокрЛП(Слово) = ВРег(СокрЛП(Слово)) Тогда
		Возврат Слово;
	КонецЕсли;

	// --- 4. Перевірка на порядковий числівник (1-й, 2-а, 3-тє тощо) ---
	// Якщо містить цифру на початку - відмінюємо тільки закінчення після дефісу
	ПозАраб = 0;
	Для І = 1 По СтрДлина(Слово) Цикл
		Код = КодСимвола(Сред(Слово, І, 1));
		Если Код >= 48 И Код <= 57 Тогда
			ПозАраб = І;
		КонецЕсли;
	КонецЦикла;

	Если ПозАраб > 0 Тогда
		// Слово починається з цифри: відмінюємо тільки текстову частину після дефісу
		ПозДефіс = СтрНайти(Слово, "-");
		Если ПозДефіс > 0 Тогда
			ЦифровaЧастина = Лев(Слово, ПозДефіс);
			ТекстоваЧастина = Сред(Слово, ПозДефіс + 1);
			Возврат ЦифровaЧастина + _ПолучитьСлово(ТекстоваЧастина, Пол, Падеж, Язык, ТипСлова, ПідказкаРід, ПідказкаТип);
		КонецЕсли;
		// Немає дефісу - повертаємо як є
		Возврат Слово;
	КонецЕсли;

	// --- 5. Складні слова через дефіс ---
	ПозДефіс = СтрНайти(Слово, "-");
	Если ПозДефіс > 0 Тогда
		ЧастинаДо  = Лев(Слово, ПозДефіс - 1);
		ЧастинаПіс = Сред(Слово, ПозДефіс + 1);

		// Перевіряємо чи перша частина є незмінним префіксом
		Если _НайтиВСловаре("НезмінніЧастиниСлів", НРег(ЧастинаДо)) Тогда
			Возврат ЧастинаДо + "-" + _ПолучитьСлово(ЧастинаПіс, Пол, Падеж, Язык, ТипСлова, ПідказкаРід, ПідказкаТип);
		КонецЕсли;

		// Відмінюємо кожну частину
		ВідмінЧастинаДо  = _ПолучитьСлово(ЧастинаДо, Пол, Падеж, Язык, ТипСлова, ПідказкаРід, ПідказкаТип);
		ВідмінЧастинаПіс = _ПолучитьСлово(ЧастинаПіс, Пол, Падеж, Язык, ТипСлова, ПідказкаРід, ПідказкаТип);
		Возврат ВідмінЧастинаДо + "-" + ВідмінЧастинаПіс;
	КонецЕсли;

	// --- 6. Слова з апострофом: Тетяна → Тетяни ---
	// Апостроф зберігаємо, відмінюємо слово цілком

	// --- 7. Перевірка на незмінне слово у словнику ---
	Если _НайтиВСловаре("Незмінні", НРег(СокрЛП(Слово))) Тогда
		Возврат Слово;
	КонецЕсли;

	// --- 8. Підготовка до аналізу: переводимо у нижній регістр ---
	СловоОриг  = Слово;
	СловоМал   = НРег(СокрЛП(Слово));
	Довжина    = СтрДлина(СловоМал);

	// --- 9. Визначення закінчення та основи ---
	Основа       = "";
	Закінчення   = _ОпределитьОкончание(СловоМал, Основа);
	ОстЗакінч    = ?(СтрДлина(Закінчення) > 0, Прав(Закінчення, 1), "");
	ПердОстЗакінч = ?(СтрДлина(Закінчення) > 1, Сред(Закінчення, СтрДлина(Закінчення) - 1, 1), "");
	ОстОснова    = ?(СтрДлина(Основа) > 0, Прав(Основа, 1), "");

	// --- 10. Визначення роду ---
	// Спочатку з параметра
	Род = "";
	Якщо = НРег(Пол);
	Если ПідказкаРід = "Ч" ИЛИ Якщо = "м" ИЛИ Якщо = "ч" Тогда
		Род = "Ч";
	ИначеЕсли ПідказкаРід = "Ж" ИЛИ Якщо = "ж" Тогда
		Род = "Ж";
	КонецЕсли;

	// Перевірка у словниках чоловічих/жіночих імен
	Если ТипСлова = "Имя" ИЛИ ТипСлова = "Фамилия" Тогда
		Если _НайтиВСловаре("ЧоловічіІмена", СловоМал) Тогда
			Род = "Ч"; // Чоловіче ім'я з нетиповим закінченням (Микола, Ілля)
		ИначеЕсли _НайтиВСловаре("ЖіночіІмена", СловоМал) Тогда
			Род = "Ж"; // Жіноче ім'я з нетиповим закінченням (Любов)
		КонецЕсли;
	КонецЕсли;

	// Визначення роду автоматично по закінченню
	// УВАГА: СтрНайти(Рядок, "") у 1С повертає > 0 (порожній рядок "знайдено" будь-де).
	// Тому перед кожним СтрНайти ОБОВ'ЯЗКОВО перевіряємо НЕ ПустаяСтрока(ОстЗакінч).
	// Без цього захисту слова на приголосну (менеджер, директор) отримують Рід="Ж" і відмінюються як 3-я відміна.
	Если ПустаяСтрока(Род) Тогда
		Если НЕ ПустаяСтрока(ОстЗакінч) И СтрНайти("аяі", ОстЗакінч) > 0 Тогда
			// Закінчення -а, -я, -і → жіночий або 1-а відміна чоловічий
			// Якщо в словнику чоловічих - вже встановлено вище
			Род = "Ж";
		ИначеЕсли НЕ ПустаяСтрока(ОстЗакінч) И СтрНайти("ьоеє", ОстЗакінч) > 0 Тогда
			Если ОстЗакінч = "ь" Тогда
				Род = "Ж"; // 3-я відміна
			ИначеЕсли СтрНайти("ое", ОстЗакінч) > 0 Тогда
				Род = "С"; // Середній рід
			Иначе
				Род = "С"; // є, ю - переважно середній
			КонецЕсли;
		ИначеЕсли ПустаяСтрока(Закінчення) Тогда
			Род = "Ч"; // Закінчення на приголосну → чоловічий
		Иначе
			Род = "С";
		КонецЕсли;
	КонецЕсли;

	// --- 11. Спеціальна обробка для чоловічих імен на -а/-я (Микола, Ілля) ---
	ЦеЧоловічеНа_А_Я = Ложь;
	Если Род = "Ч" И СтрНайти("ая", ОстЗакінч) > 0 Тогда
		// Чоловіки 1-ї відміни (Микола, Ілля, Сава)
		ЦеЧоловічеНа_А_Я = Истина;
	КонецЕсли;

	// --- 12. Перевірка на незмінне слово в посаді ---
	Если ТипСлова = "Должность" И _НайтиВСловаре("НезмінніСловаДляПосад", СловоМал) Тогда
		Возврат СловоОриг;
	КонецЕсли;

	// --- 13. Називний відмінок (1) - повертаємо без змін ---
	Если Падеж = 1 Тогда
		Возврат СловоОриг;
	КонецЕсли;

	// --- 13.1. Слова на "-ець" (чоловічий рід, II відміна, біглий голосний) ---
	// Фахівець, продавець, кравець, молодець, купець тощо.
	// В непрямих відмінках "е" з суфікса "-ець" зникає: фахівець → фахівця (Р), фахівцю (Д, К) тощо.
	// Ці слова алгоритм помилково відносить до ж.р. 3-ї відміни через закінчення "ь".
	Если Прав(СловоМал, 3) = "ець" И СтрДлина(СловоМал) > 3 Тогда
		// Основа без біглого "е": "фахів" + "ц" = "фахівц"
		ОснЕць = Лев(СловоМал, СтрДлина(СловоМал) - 3) + "ц";
		Если Падеж = 2 Тогда
			Виход = ОснЕць + "я";     // фахівця
		ИначеЕсли Падеж = 3 Тогда
			Виход = ОснЕць + "еві";   // фахівцеві (літ. норма для осіб)
		ИначеЕсли Падеж = 4 Тогда
			Виход = ОснЕць + "я";     // фахівця
		ИначеЕсли Падеж = 5 Тогда
			Виход = ОснЕць + "ем";    // фахівцем
		ИначеЕсли Падеж = 6 Тогда
			Виход = ОснЕць + "еві";   // фахівцеві
		ИначеЕсли Падеж = 7 Тогда
			Виход = ОснЕць + "ю";     // фахівцю
		КонецЕсли;
		Возврат _СохранитьРегистр(СловоОриг, Виход);
	КонецЕсли;

	// --- 13.2. Прізвища на -ова/-ева/-єва (прикметниковий тип відмінювання, жіночий рід) ---
	// Картавцева, Іванова, Петрова, Сидорова → відмінюються як прикметники жіночого роду.
	// Ознака: ТипСлова="Фамилия", жіночий рід, закінчення "-а", основа >= 4 символів на "-ов/-ев/-єв".
	// Відрізняємо від іменникових прізвищ на -ва (Рева, Лева, Нова) саме за довжиною основи.
	// Р: -ої (Картавцевої), Д: -ій, Зн: -у, Ор: -ою, М: -ій, Кл: = Називний
	Если ТипСлова = "Фамилия" И Род = "Ж" И ОстЗакінч = "а" И СтрДлина(Основа) >= 4 Тогда
		Если Прав(Основа, 2) = "ов" ИЛИ Прав(Основа, 2) = "ев" ИЛИ Прав(Основа, 2) = "єв" Тогда
			Если Падеж = 2 Тогда
				Виход = Основа + "ої";   // Картавцевої, Іванової, Петрової
			ИначеЕсли Падеж = 3 Тогда
				Виход = Основа + "ій";   // Картавцевій, Івановій, Петровій
			ИначеЕсли Падеж = 4 Тогда
				Виход = Основа + "у";    // Картавцеву, Іванову, Петрову
			ИначеЕсли Падеж = 5 Тогда
				Виход = Основа + "ою";   // Картавцевою, Іванівною, Петровою
			ИначеЕсли Падеж = 6 Тогда
				Виход = Основа + "ій";   // Картавцевій, Івановій, Петровій
			ИначеЕсли Падеж = 7 Тогда
				Виход = СловоМал;        // Кличний = Називний для прізвищ (Картавцева)
			КонецЕсли;
			Возврат _СохранитьРегистр(СловоОриг, Виход);
		КонецЕсли;
	КонецЕсли;

	// --- 14. Визначення прикметника ---
	// Прикметники: -ий, -ій, -ій → прикметникове відмінювання
	ЦеПрикметник  = Ложь;
	ТипПрикметника = "";

	// Власні імена (ТипСлова="Имя") не повинні відмінюватись як прикметники на -ій/-ий:
	// Сергій -> Сергія (а не Сергього)
	Если СтрДлина(СловоМал) >= 3 И ТипСлова <> "Имя" Тогда
		ОстаннТри = Прав(СловоМал, 3);
		Если ОстаннТри = "ний" ИЛИ ОстаннТри = "дій" ИЛИ Прав(СловоМал, 2) = "ий" ИЛИ Прав(СловоМал, 2) = "ій" Тогда
			Если Прав(СловоМал, 2) = "ій" Тогда
				ЦеПрикметник  = Истина;
				ТипПрикметника = "ій";
				Основа = Лев(СловоМал, Довжина - 2);
			ИначеЕсли Прав(СловоМал, 2) = "ий" Тогда
				ЦеПрикметник  = Истина;
				ТипПрикметника = "ий";
				Основа = Лев(СловоМал, Довжина - 2);
			КонецЕсли;
		КонецЕсли;
		// Жіночі прикметникові форми
		Если НЕ ЦеПрикметник Тогда
			Если Прав(СловоМал, 2) = "ня" ИЛИ Прав(СловоМал, 2) = "га" ИЛИ Прав(СловоМал, 2) = "ра" ИЛИ Прав(СловоМал, 2) = "да" Тогда
				// можливо прикметникова форма жіночого роду - перевірка по 3 символах
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Виход = "";

	// ===========================================================================
	// ВІДМІНЮВАННЯ ПРИКМЕТНИКІВ
	// ===========================================================================

	Если ЦеПрикметник И Род = "Ч" Тогда

		Если ТипПрикметника = "ий" Тогда
			// Твердий прикметник чоловічого роду: -ий
			Если Падеж = 2 Тогда
				Виход = Основа + "ого";
			ИначеЕсли Падеж = 3 Тогда
				Виход = Основа + "ому";
			ИначеЕсли Падеж = 4 Тогда
				Виход = Основа + "ого"; // одушевлений
			ИначеЕсли Падеж = 5 Тогда
				Виход = Основа + "им";
			ИначеЕсли Падеж = 6 Тогда
				Если _ЯвляетсяШиплячей(Прав(Основа, 1)) Тогда
					Виход = Основа + "ому";
				Иначе
					Виход = Основа + "ому";
				КонецЕсли;
			ИначеЕсли Падеж = 7 Тогда
				Виход = СловоМал; // кличний = називний
			КонецЕсли;

		ИначеЕсли ТипПрикметника = "ій" Тогда
			// М'який прикметник чоловічого роду: -ній, -ній тощо
			Если Падеж = 2 Тогда
				Виход = Основа + "ього";
			ИначеЕсли Падеж = 3 Тогда
				Виход = Основа + "ьому";
			ИначеЕсли Падеж = 4 Тогда
				Виход = Основа + "ього"; // одушевлений
			ИначеЕсли Падеж = 5 Тогда
				Виход = Основа + "ім"; // синій→синім, передній→передній (УМ: Ор. м'якого прикм.)
			ИначеЕсли Падеж = 6 Тогда
				Виход = Основа + "ьому"; // синій→синьому, передній→передньому (УМ: М. м'якого прикм.)
			ИначеЕсли Падеж = 7 Тогда
				Виход = СловоМал;
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ЦеПрикметник И Род = "Ж" Тогда

		// Жіночий прикметник
		Если ТипПрикметника = "ій" Тогда
			Основа = Лев(СловоМал, Довжина - 2);
			Если Падеж = 2 Тогда
				Виход = Основа + "ньої";
			ИначеЕсли Падеж = 3 Тогда
				Виход = Основа + "ній";
			ИначеЕсли Падеж = 4 Тогда
				Виход = Основа + "ню";
			ИначеЕсли Падеж = 5 Тогда
				Виход = Основа + "ньою";
			ИначеЕсли Падеж = 6 Тогда
				Виход = Основа + "ній";
			ИначеЕсли Падеж = 7 Тогда
				Виход = СловоМал;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	// Якщо визначили прикметник і є результат - повертаємо
	Если ЦеПрикметник И НЕ ПустаяСтрока(Виход) Тогда
		Возврат _СохранитьРегистр(СловоОриг, Виход);
	КонецЕсли;

	// ===========================================================================
	// ВІДМІНЮВАННЯ ІМЕННИКІВ
	// ===========================================================================

	// Перераховуємо Основу та Закінчення (для прикметників вони були перевизначені)
	Основа     = "";
	Закінчення = _ОпределитьОкончание(СловоМал, Основа);
	ОстЗакінч  = ?(СтрДлина(Закінчення) > 0, Прав(Закінчення, 1), "");
	ОстОснова  = ?(СтрДлина(Основа) > 0, Прав(Основа, 1), "");

	// Жіночі прізвища на -ко не відмінюються: Новіченко, Панасенко тощо.
	Если ТипСлова = "Фамилия" И ОстЗакінч = "о" И Род = "Ж" Тогда
		Возврат СловоОриг;
	КонецЕсли

	// --- Визначення відміни ---
	Відміна = 0;

	Если ОстЗакінч = "а" Тогда
		Відміна = 1; // 1-а відміна: -а (тверда основа)
	ИначеЕсли ОстЗакінч = "я" Тогда
		Відміна = 1; // 1-а відміна: -я (м'яка основа або після голосного)
	ИначеЕсли ОстЗакінч = "ь" Тогда
		Если Род = "Ч" Тогда
			Відміна = 2; // 2-а відміна: чоловічий рід на -ь (Король, Василь)
		Иначе
			Відміна = 3; // 3-я відміна: -ь (жіночий рід)
		КонецЕсли;
	ИначеЕсли ОстЗакінч = "о" Тогда
		Відміна = 2; // 2-а відміна: -о (середній рід)
	ИначеЕсли СтрНайти("еє", ОстЗакінч) > 0 Тогда
		Відміна = 2; // 2-а відміна: -е/-є (середній рід)
	ИначеЕсли ПустаяСтрока(Закінчення) Тогда
		Відміна = 2; // 2-а відміна: закінчення на приголосну (чоловічий)
	Иначе
		// Інші: намагаємось за родом
		Если Род = "Ж" Тогда
			Відміна = 3;
		Иначе
			Відміна = 2;
		КонецЕсли;
	КонецЕсли;

	// Чоловічі імена на -а/-я (Микола) → 1-а відміна чоловічого роду
	// Жіночі на приголосну (Любов) → 3-я відміна жіночого роду
	Если Род = "Ж" И (ПустаяСтрока(Закінчення) ИЛИ ОстЗакінч = "ь") Тогда
		Если ТипСлова = "Фамилия" Тогда
			// Жіночі прізвища на приголосну — незмінні в усіх відмінках (Коваль, Мороз, Черевань)
			Возврат СловоОриг;
		Иначе
			Відміна = 3; // жіночі імена на приголосну (Любов, Нінель) → 3-я відміна
		КонецЕсли;
	КонецЕсли;

	// Визначення м'якості основи
	МяккіПрігл  = "йцзснтлрд"; // умовно м'які (перед яким пишуть ь, або -й сам по собі)
	ОснМяка     = СтрДлина(Основа) > 0 И (
		Прав(Основа, 1) = "й" ИЛИ
		_ЯвляетсяШиплячей(Прав(Основа, 1)) ИЛИ
		(СтрДлина(Закінчення) >= 2 И Лев(Закінчення, 1) = "ь")
	);

	// =======================================================================
	// 1-А ВІДМІНА (закінчення -а, -я) → в основному жіночий рід та Микола тощо
	// =======================================================================
	Если Відміна = 1 Тогда

		// Визначення типу закінчення
		Якщо_Я = ОстЗакінч = "я";
		// М'яка основа (закінчення -я): Марія, Тетяна, Ілля
		// Тверда основа (закінчення -а): Ольга, Оксана

		Если ОстЗакінч = "а" Тогда
			// --- 1-а відміна, тверда основа (-а): Ольга, Оксана, Тарасенко→Тарасенка ---
			// Якщо основа закінчується на г,к,х - при Давальному/Місцевому пом'якшення
			ОстОсн = ?(СтрДлина(Основа) > 0, Прав(Основа, 1), "");

			Если Падеж = 2 Тогда
				// Родовий: -а → -и
				Если _ЯвляетсяШиплячей(ОстОсн) ИЛИ ОстОсн = "й" Тогда
					Виход = Основа + "і";
				Иначе
					Виход = Основа + "и";
				КонецЕсли;
			ИначеЕсли Падеж = 3 Тогда
				// Давальний: -а → -і; г→з, к→ц, х→с (УМ Прим. 1: Ольга→Ользі, Палажка→Палажці)
				Если ОстОсн = "г" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "зі";
				ИначеЕсли ОстОсн = "к" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "ці";
				ИначеЕсли ОстОсн = "х" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "сі";
				Иначе
					Виход = Основа + "і";
				КонецЕсли;
			ИначеЕсли Падеж = 4 Тогда
				// Знахідний: -а → -у
				Виход = Основа + "у";
			ИначеЕсли Падеж = 5 Тогда
				// Орудний: -а → -ою (тверда) або -ею (після шиплячої)
				Если _ЯвляетсяШиплячей(ОстОсн) Тогда
					Виход = Основа + "ею";
				Иначе
					Виход = Основа + "ою";
				КонецЕсли;
			ИначеЕсли Падеж = 6 Тогда
				// Місцевий: -а → -і; г→з, к→ц, х→с (УМ Прим. 1)
				Если ОстОсн = "г" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "зі";
				ИначеЕсли ОстОсн = "к" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "ці";
				ИначеЕсли ОстОсн = "х" Тогда
					Виход = Лев(Основа, СтрДлина(Основа) - 1) + "сі";
				Иначе
					Виход = Основа + "і";
				КонецЕсли;
			ИначеЕсли Падеж = 7 Тогда
				// Кличний: -а → -о (ж.р.) або = Називний (ч.р. Микола)
				Если ЦеЧоловічеНа_А_Я Тогда
					Виход = Основа + "о"; // УМ: Микола→Миколо, Сава→Саво, Лука→Луко
				Иначе
					Виход = Основа + "о";
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли ОстЗакінч = "я" Тогда
			// --- Особливий підвипадок: слова на "-ія" (Наталія, Марія, Надія, Валерія) ---
			// _ОпределитьОкончание виділяє "ія" як закінчення (обидві літери голосні),
			// тому Основа закінчується на приголосну ("натал", "мар", "над").
			// Для правильного відмінювання "і" вважається частиною основи:
			//   "наталі" → Р/Д/М: "наталії", Зн: "наталію", Ор: "наталією", Кл: "наталіє"
			Если Прав(СловоМал, 2) = "ія" Тогда
				ОснНаІ = Лев(СловоМал, СтрДлина(СловоМал) - 1); // "наталі", "марі", "наді"
				Если Падеж = 2 Тогда
					Виход = ОснНаІ + "ї";   // Наталії, Марії, Надії
				ИначеЕсли Падеж = 3 Тогда
					Виход = ОснНаІ + "ї";   // Наталії, Марії, Надії
				ИначеЕсли Падеж = 4 Тогда
					Виход = ОснНаІ + "ю";   // Наталію, Марію, Надію
				ИначеЕсли Падеж = 5 Тогда
					Виход = ОснНаІ + "єю";  // Наталією, Марією, Надією
				ИначеЕсли Падеж = 6 Тогда
					Виход = ОснНаІ + "ї";   // Наталії, Марії, Надії
				ИначеЕсли Падеж = 7 Тогда
					Виход = ОснНаІ + "є";   // Наталіє, Маріє, Надіє
				КонецЕсли;
				Возврат _СохранитьРегистр(СловоОриг, Виход);
			КонецЕсли;

			// --- 1-а відміна, м'яка основа (-я): Тетяна, Ілля тощо ---
			// Перевіряємо чи перед -я стоїть голосна (Надія → ї в Родовому)
			ПередЯ = ?(СтрДлина(Основа) > 0, Прав(Основа, 1), "");
			ГолоснаПередЯ = _ЯвляетсяГласной(ПередЯ);

			Если Падеж = 2 Тогда
				// Родовий: -я → -і (після приголосної) або -ї (після голосної)
				Если ГолоснаПередЯ Тогда
					Виход = Основа + "ї";
				Иначе
					Виход = Основа + "і";
				КонецЕсли;
			ИначеЕсли Падеж = 3 Тогда
				// Давальний: -я → -і або -ї
				Если ГолоснаПередЯ Тогда
					Виход = Основа + "ї";
				Иначе
					Виход = Основа + "і";
				КонецЕсли;
			ИначеЕсли Падеж = 4 Тогда
				// Знахідний: -я → -ю
				Виход = Основа + "ю";
			ИначеЕсли Падеж = 5 Тогда
				// Орудний: -я → -єю (після голосної: Марія→Марією) або -ею (після приголосної: Наталя→Наталею)
				// УМ: тверда гр. -ою, м'яка гр. (після приголосної) -ею, після голосної -єю
				Если ГолоснаПередЯ Тогда
					Виход = Основа + "єю"; // Марія→Марією, Надія→Надією
				Иначе
					Виход = Основа + "ею"; // Наталя→Наталею, Ілля→Іллею
				КонецЕсли;
			ИначеЕсли Падеж = 6 Тогда
				// Місцевий: -я → -і або -ї
				Если ГолоснаПередЯ Тогда
					Виход = Основа + "ї";
				Иначе
					Виход = Основа + "і";
				КонецЕсли;
			ИначеЕсли Падеж = 7 Тогда
				// Кличний: -я → -є (ж.р.) або -е (ч.р.: Ілля→Ілле) (УМ м'яка гр. І відміни)
				Если ЦеЧоловічеНа_А_Я Тогда
					Виход = Основа + "е"; // УМ: Ілля→Ілле, Кузьма(Кузьмо через -а)
				Иначе
					Если ГолоснаПередЯ Тогда
						Виход = Основа + "є";
					Иначе
						Виход = Основа + "є";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	// =======================================================================
	// 2-А ВІДМІНА (чоловічий: на приголосну, на -о/-е; середній: -о,-е,-є)
	// =======================================================================
	ИначеЕсли Відміна = 2 Тогда

		ОстОсн = ?(СтрДлина(Основа) > 0, Прав(Основа, 1), "");
		// Другий символ з кінця основи (або закінчення)
		Передост  = "";
		Если СтрДлина(Основа) >= 2 Тогда
			Передост = Сред(Основа, СтрДлина(Основа) - 1, 1);
		КонецЕсли;

		// Визначення твердості/м'якості
		МяккіПрінд  = "йцзснтлрд";
		ОснМяка2 = (ОстОсн = "й"); // УМ: м'яка група (основа на й): Сергій, Юрій, Андрій

		Если Род = "Ч" ИЛИ (Род = "С" И ПустаяСтрока(Закінчення)) ИЛИ ЦеЧоловічеНа_А_Я Тогда
			// --- Чоловічий рід 2-ї відміни ---

			// Особливий випадок: закінчення -о (середньо-чоловічий Дніпро, Дніпра)
			Если ОстЗакінч = "о" И НЕ ПустаяСтрока(Закінчення) Тогда
				// Слова типу "Дніпро", "метро" → але метро незмінне
				Если Падеж = 2 Тогда
					Виход = Основа + "а";
				ИначеЕсли Падеж = 3 Тогда
					Виход = Основа + "у";
				ИначеЕсли Падеж = 4 Тогда
					Виход = СловоМал;
				ИначеЕсли Падеж = 5 Тогда
					Виход = Основа + "ом";
				ИначеЕсли Падеж = 6 Тогда
					Виход = Основа + "і";
				ИначеЕсли Падеж = 7 Тогда
					Виход = Основа + "е";
				КонецЕсли;
			ИначеЕсли ОстЗакінч = "ь" Тогда
				// Чоловічий рід на -ь: Король -> Короля, Королю, Королем
				Если Падеж = 2 Тогда
					Виход = Основа + "я";
				ИначеЕсли Падеж = 3 Тогда
					Виход = Основа + "ю";
				ИначеЕсли Падеж = 4 Тогда
					Виход = Основа + "я";
				ИначеЕсли Падеж = 5 Тогда
					Виход = Основа + "ем";
				ИначеЕсли Падеж = 6 Тогда
					Виход = Основа + "ю";
				ИначеЕсли Падеж = 7 Тогда
					Виход = Основа + "ю";
				КонецЕсли;
			Иначе
				// Загальний випадок чоловічого 2-ї відміни (закінчення на приголосну)
				// УМ §2 ІІ відміна: м'яка (й), мішана (шиплячі), тверда
				Если ОснМяка2 Тогда
					// УМ: М'яка група — основа на -й: Сергій, Юрій, Андрій
					// Р:-я, Д:-єві, Зн:-я, Ор:-єм, М:-єві, Кл:-ю
					ОснБезЙ = Лев(Основа, СтрДлина(Основа) - 1); // відрізаємо -й
					Если Падеж = 2 Тогда
						Виход = ОснБезЙ + "я"; // Сергія, Андрія
					ИначеЕсли Падеж = 3 Тогда
						Виход = ОснБезЙ + "єві"; // Сергієві, Андрієві
					ИначеЕсли Падеж = 4 Тогда
						Виход = ОснБезЙ + "я"; // Сергія, Андрія
					ИначеЕсли Падеж = 5 Тогда
						Виход = ОснБезЙ + "єм"; // Сергієм, Андрієм
					ИначеЕсли Падеж = 6 Тогда
						Виход = ОснБезЙ + "єві"; // Сергієві, Андрієві
					ИначеЕсли Падеж = 7 Тогда
						Виход = ОснБезЙ + "ю"; // Сергію, Андрію
					КонецЕсли;
				// УМ: Мішана група — шиплячі ж/ч/ш/щ: Тиміш, Васильович
				// Р:-а, Д:-еві/-у(П), Зн:-а, Ор:-ем, М:-еві/-у(П), Кл:-е/-у(П)
				ИначеЕсли _ЯвляетсяШиплячей(ОстОсн) Тогда
					Если Падеж = 2 Тогда
						Виход = Основа + "а"; // Тимоша, Васильовича
					ИначеЕсли Падеж = 3 Тогда
						// По-батькові: літ. норма -у (Васильовичу); імена/прізвища: -еві (Тимошеві)
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						Иначе
							Виход = Основа + "еві";
						КонецЕсли;
					ИначеЕсли Падеж = 4 Тогда
						Виход = Основа + "а"; // Тимоша, Васильовича
					ИначеЕсли Падеж = 5 Тогда
						Виход = Основа + "ем"; // Тимошем, Васильовичем
					ИначеЕсли Падеж = 6 Тогда
						// По-батькові: літ. норма -у (Васильовичу); імена/прізвища: -еві (Тимошеві)
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						Иначе
							Виход = Основа + "еві";
						КонецЕсли;
					ИначеЕсли Падеж = 7 Тогда
						// По-батькові: літ. норма -у (Васильовичу); імена/прізвища: -е (Тимоше)
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						Иначе
							Виход = Основа + "е";
						КонецЕсли;
					КонецЕсли;
				Иначе
					// УМ: Тверда група — решта приголосних: Іван, Гнатюк, Петро
					// Р:-а, Д:-ові/-у(П), Зн:-а, Ор:-ом, М:-ові/-у(П), Кл:-е/-у(П)
					Если Падеж = 2 Тогда
						Виход = Основа + "а";
					ИначеЕсли Падеж = 3 Тогда
						// По-батькові: літ. норма -у (Іваничу); іменники: -ові
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						Иначе
							Виход = Основа + "ові";
						КонецЕсли;
					ИначеЕсли Падеж = 4 Тогда
						// Знахідний = Родовий (одушевлений)
						Виход = Основа + "а";
					ИначеЕсли Падеж = 5 Тогда
						// Орудний: -ом (тверда основа)
						Виход = Основа + "ом";
					ИначеЕсли Падеж = 6 Тогда
						// По-батькові: літ. норма -у (Іваничу); іменники: -ові
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						Иначе
							Виход = Основа + "ові";
						КонецЕсли;
					ИначеЕсли Падеж = 7 Тогда
						// Кличний: по-батькові → -у; прізвища на -ко → -у; інші → -е
						Если ТипСлова = "Отчество" Тогда
							Виход = Основа + "у";
						ИначеЕсли _ЯвляетсяШиплячей(ОстОсн) Тогда
							Виход = Основа + "е";
						ИначеЕсли ОстОсн = "к" ИЛИ ОстОсн = "г" ИЛИ ОстОсн = "х" Тогда
							// Іваненко → Іваненку (для прізвищ на -ко)
							Если Прав(СловоМал, 2) = "ко" ИЛИ Прав(СловоМал, 3) = "нко" Тогда
								Виход = Основа + "у";
							Иначе
								Виход = Основа + "е";
							КонецЕсли;
						Иначе
							Виход = Основа + "е";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Род = "С" Тогда
			// --- Середній рід 2-ї відміни (-о, -е, -є): поле, вікно, серце ---
			Если ОстЗакінч = "о" Тогда
				Если Падеж = 2 Тогда
					Виход = Основа + "а";
				ИначеЕсли Падеж = 3 Тогда
					Виход = Основа + "у";
				ИначеЕсли Падеж = 4 Тогда
					Виход = СловоМал; // = Називний
				ИначеЕсли Падеж = 5 Тогда
					Виход = Основа + "ом";
				ИначеЕсли Падеж = 6 Тогда
					Виход = Основа + "і";
				ИначеЕсли Падеж = 7 Тогда
					Виход = СловоМал; // = Називний
				КонецЕсли;
			ИначеЕсли ОстЗакінч = "е" ИЛИ ОстЗакінч = "є" Тогда
				Если Падеж = 2 Тогда
					Виход = Основа + "я";
				ИначеЕсли Падеж = 3 Тогда
					Виход = Основа + "ю";
				ИначеЕсли Падеж = 4 Тогда
					Виход = СловоМал;
				ИначеЕсли Падеж = 5 Тогда
					Виход = Основа + "ем";
				ИначеЕсли Падеж = 6 Тогда
					Виход = Основа + "і";
				ИначеЕсли Падеж = 7 Тогда
					Виход = СловоМал;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	// =======================================================================
	// 3-Я ВІДМІНА (жіночий рід: на -ь або м'яку приголосну: ніч, любов)
	// =======================================================================
	ИначеЕсли Відміна = 3 Тогда

		// Слово може закінчуватись на -ь (ніч → ніч, сіль → солі)
		// або на м'яку приголосну (Любов → Любові)
		ОснБез_ь = ?(ОстЗакінч = "ь", Лев(СловоМал, Довжина - 1), СловоМал);
		ОснМал   = ?(ОстЗакінч = "ь", Лев(СловоМал, Довжина - 1), Основа);

		// Визначаємо чи треба апостроф у Орудному (мати → матір'ю)
		ОстОснМал = ?(СтрДлина(ОснМал) > 0, Прав(ОснМал, 1), "");

		Если Падеж = 2 Тогда
			Виход = ОснМал + "і";
		ИначеЕсли Падеж = 3 Тогда
			Виход = ОснМал + "і";
		ИначеЕсли Падеж = 4 Тогда
			Виход = СловоМал; // = Називний
		ИначеЕсли Падеж = 5 Тогда
			// Орудний: -ю (Любов → Любов'ю якщо потрібен апостроф)
			Если _ЯвляетсяГласной(Прав(ОснМал, 1)) Тогда
				Виход = ОснМал + "'ю";
			Иначе
				Виход = ОснМал + "ю";
			КонецЕсли;
		ИначеЕсли Падеж = 6 Тогда
			Виход = ОснМал + "і";
		ИначеЕсли Падеж = 7 Тогда
			// Кличний: -е (ніч → ноче, мати → мати)
			Если ОстЗакінч = "ь" Тогда
				Виход = ОснМал + "е";
			Иначе
				Виход = ОснМал + "е"; // УМ: Любов→Любове, Нінель→Нінеле (ІІІ відміна кличний)
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	// --- 15. Якщо не вдалось визначити - повертаємо слово без змін ---
	Если ПустаяСтрока(Виход) Тогда
		Возврат СловоОриг;
	КонецЕсли;

	Возврат _СохранитьРегистр(СловоОриг, Виход);

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция _ОпределитьПолПоОтчеству
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Визначає стать особи по-батькові (патронімічному імені).
//   Чоловічий по-батькові: -ович, -йович, -ьович.
//   Жіночий по-батькові: -івна, -ївна, -овна.
//
// Параметри:
//   Отчество (Строка) – по-батькові у будь-якому регістрі.
//
// Повертає:
//   Строка – "Ч" (чоловіча), "Ж" (жіноча), "" (невизначено).
// ------------------------------------------------------------------------------------------------
Функция _ОпределитьПолПоОтчеству(Отчество)

	Відч = НРег(СокрЛП(Отчество));

	Если ПустаяСтрока(Відч) ИЛИ СтрДлина(Відч) < 4 Тогда
		Возврат "";
	КонецЕсли;

	// Чоловічий: закінчується на -ович, -йович (Миколайович, Юрійович)
	Если Прав(Відч, 4) = "ович" ИЛИ Прав(Відч, 4) = "евич" Тогда
		Возврат "Ч";
	КонецЕсли;

	// Жіночий: закінчується на -івна, -овна, -ївна (Миколаївна, Юріївна)
	Если Прав(Відч, 4) = "івна" ИЛИ Прав(Відч, 4) = "овна" ИЛИ Прав(Відч, 4) = "євна" ИЛИ Прав(Відч, 4) = "ївна" Тогда       
		Возврат "Ж";
	КонецЕсли;

	Возврат "";

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция _ПолучитьЧасть
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює одну складову частину ПІБ (прізвище, ім'я або по-батькові).
//   Враховує стать при відмінюванні.
//
// Параметри:
//   Слово     (Строка) – вхідна частина ПІБ.
//   Пол       (Строка) – "Ч"/"М" або "Ж".
//   Падеж     (Число)  – відмінок 1..7.
//   ТипСлова  (Строка) – "Фамилия" = прізвище, "Имя" = ім'я, "Отчество" = по-батькові.
//
// Повертає:
//   Строка – відмінена частина ПІБ.
// ------------------------------------------------------------------------------------------------
Функция _ПолучитьЧасть(Слово, Пол, Падеж, ТипСлова)

	Если ПустаяСтрока(Слово) Тогда
		Возврат "";
	КонецЕсли;

	// Ініціали (одна літера з крапкою)
	Если СтрДлина(СокрЛП(Слово)) <= 2 И Прав(СокрЛП(Слово), 1) = "." Тогда
		Возврат Слово; // ініціали не відмінюємо
	КонецЕсли;

	Возврат _ПолучитьСлово(Слово, Пол, Падеж, "UA", ТипСлова);

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция _ПолучитьФрагментДолжности
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює один фрагмент посади (одне слово або ініціали).
//   Незмінні слова (прийменники, сполучники) залишаються без змін.
//
// Параметри:
//   Слово  (Строка) – одне слово з посади.
//   Падеж  (Число)  – відмінок 1..7.
//
// Повертає:
//   Строка – відмінений фрагмент.
// ------------------------------------------------------------------------------------------------
Функция _ПолучитьФрагментДолжности(Слово, Падеж)

	Если ПустаяСтрока(Слово) Тогда
		Возврат "";
	КонецЕсли;

	// Незмінні слова
	Если _НайтиВСловаре("НезмінніСловаДляПосад", НРег(Слово)) Тогда
		Возврат Слово;
	КонецЕсли;

	// Незмінні слова (авто, кіно тощо)
	Если _НайтиВСловаре("Незмінні", НРег(Слово)) Тогда
		Возврат Слово;
	КонецЕсли;

	Возврат _ПолучитьСлово(Слово, "", Падеж, "UA", "Должность");

КонецФункции

// Призначення:
//   Повертає таблицю значень з усіма формами відмінювання українських місяців.
//   Кожен рядок відповідає одному місяцю та містить 7 стовпців — по одному на відмінок.
//
// Повертає:
//   ТаблицяЗначень – стовпці: Називний, Родовий, Давальний, Знахідний, Орудний, Місцевий, Кличний.
//
// Особливості:
//   Словникові форми відповідають нормам сучасного українського правопису.
//
Функция ТаблицяВідмінюванняУкраїнськихМісяців()

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Називний");
	ТЗ.Колонки.Добавить("Родовий");
	ТЗ.Колонки.Добавить("Давальний");
	ТЗ.Колонки.Добавить("Знахідний");
	ТЗ.Колонки.Добавить("Орудний");
	ТЗ.Колонки.Добавить("Місцевий");
	ТЗ.Колонки.Добавить("Кличний");

	МісяціДані = Новый Массив;
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "січень",   "січня",     "січню",     "січень",   "січнем",     "січні",     "січню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "лютий",    "лютого",    "лютому",    "лютий",    "лютим",      "лютому",    "лютий"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "березень", "березня",   "березню",   "березень", "березнем",   "березні",   "березню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "квітень",  "квітня",    "квітню",    "квітень",  "квітнем",    "квітні",    "квітню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "травень",  "травня",    "травню",    "травень",  "травнем",    "травні",    "травню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "червень",  "червня",    "червню",    "червень",  "червнем",    "червні",    "червню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "липень",   "липня",     "липню",     "липень",   "липнем",     "липні",     "липню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "серпень",  "серпня",    "серпню",    "серпень",  "серпнем",    "серпні",    "серпню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "вересень", "вересня",   "вересню",   "вересень", "вереснем",   "вересні",   "вересню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "жовтень",  "жовтня",    "жовтню",    "жовтень",  "жовтнем",    "жовтні",    "жовтню"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "листопад", "листопада", "листопаду", "листопад", "листопадом", "листопаді", "листопаде"));
	МісяціДані.Добавить(Новый Структура("Н,Р,Д,Зн,О,М,К", "грудень",  "грудня",    "грудню",    "грудень",  "груднем",    "грудні",    "грудню"));

	Для Каждого Дані Из МісяціДані Цикл
		Рядок = ТЗ.Добавить();
		Рядок.Називний  = Дані.Н;
		Рядок.Родовий   = Дані.Р;
		Рядок.Давальний = Дані.Д;
		Рядок.Знахідний = Дані.Зн;
		Рядок.Орудний   = Дані.О;
		Рядок.Місцевий  = Дані.М;
		Рядок.Кличний   = Дані.К;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Призначення:
//   Повертає потрібну форму місяця з рядка таблиці відмінювання за номером відмінка.
//
// Параметри:
//   РядокМісяця (РядокТаблицяЗначень) – рядок таблиці відмінювання.
//   Падеж    (Число)               – номер відмінка (1–7).
//
// Повертає:
//   Рядок – відмінкова форма назви місяця.
//
// Виключення:
//   Якщо передано відмінок поза діапазоном 1–7 — повертає називний відмінок.
//
Функция ФормаМісяцяЗаВідмінком(РядокМісяця, Падеж)

	Если Падеж = 1 Тогда
		Возврат РядокМісяця.Називний;
	ИначеЕсли Падеж = 2 Тогда
		Возврат РядокМісяця.Родовий;
	ИначеЕсли Падеж = 3 Тогда
		Возврат РядокМісяця.Давальний;
	ИначеЕсли Падеж = 4 Тогда
		Возврат РядокМісяця.Знахідний;
	ИначеЕсли Падеж = 5 Тогда
		Возврат РядокМісяця.Орудний;
	ИначеЕсли Падеж = 6 Тогда
		Возврат РядокМісяця.Місцевий;
	ИначеЕсли Падеж = 7 Тогда
		Возврат РядокМісяця.Кличний;
	КонецЕсли;

	// Невідомий відмінок — повертаємо називний як безпечне значення за замовчуванням
	Возврат РядокМісяця.Називний;

КонецФункции

