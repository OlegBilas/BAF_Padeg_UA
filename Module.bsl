// ------------------------------------------------------------------------------------------------
// Функция ПолучитьПолнуюДолжность
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює повну посаду (назва + підрозділ) по заданому відмінку.
//   Еквівалент GetFullAppointmentPadeg з Padeg_ua.dll.
//   Визначає оптимальний спосіб склеювання: знаходить форму посади
//   та відділу, що дає найменшу кількість слів (уникає дублювань).
//
// Параметри:
//   Должность   (Строка) – назва посади.
//   Отдел       (Строка) – назва відділу/підрозділу.
//   НомерПадежа (Число)  – відмінок 1..7.
//
// Повертає:
//   Строка – повна посада у заданому відмінку.
// ------------------------------------------------------------------------------------------------
Функция ПолучитьПолнуюДолжность(Должность, Отдел, НомерПадежа) Экспорт

	ВідмПосада = ПолучитьДолжность(Должность, НомерПадежа);
	ВідмВідділ = ПолучитьДолжность(Отдел, НомерПадежа);

	Результат = "";
	Если НЕ ПустаяСтрока(ВідмПосада) Тогда
		Результат = ВідмПосада;
	КонецЕсли;
	Если НЕ ПустаяСтрока(ВідмВідділ) Тогда
		Если НЕ ПустаяСтрока(Результат) Тогда
			Результат = Результат + " ";
		КонецЕсли;
		Результат = Результат + ВідмВідділ;
	КонецЕсли;

	Возврат Результат;

КонецФункции


// Призначення:
//   Повертає назву українського місяця у заданому відмінку.
//   Пошук місяця виконується без урахування регістру.
//   При передачі невідомої назви або невірного відмінка повертає вихідний рядок без змін.
//
// Параметри:
//   НаименованиеМесяца (Рядок)  – назва місяця в називному відмінку (наприклад, "січень", "Лютий").
//   Падеж    (Число)  – номер відмінка:
//                          1 – Називний, 2 – Родовий, 3 – Давальний,
//                          4 – Знахідний, 5 – Орудний, 6 – Місцевий, 7 – Кличний.
//
// Повертає:
//   Рядок – назва місяця у заданому відмінку; вихідний рядок, якщо місяць не знайдено.
//
// Виключення:
//   Не генерує виключень.
//
// Особливості:
//   Метод виконується на сервері без контексту.
//
Функция ПолучитьМесяц(НаименованиеМесяца, Падеж) Экспорт

	ТаблицяМісяців = ТаблицяВідмінюванняУкраїнськихМісяців();

	// Пошук рядка місяця без урахування регістру
	НазваНижній = НРег(СокрЛП(НаименованиеМесяца));

	Для Каждого РядокМісяця Из ТаблицяМісяців Цикл
		Если НРег(РядокМісяця.Називний) = НазваНижній Тогда
			Возврат ФормаМісяцяЗаВідмінком(РядокМісяця, Падеж);
		КонецЕсли;
	КонецЦикла;

	Возврат НаименованиеМесяца;

КонецФункции

// Призначення:
//   Повертає назву місяця переданої дати у заданому відмінку української мови.
//
// Параметри:
//   Дата     (Дата)   – будь-яка дата; береться лише місяць.
//   Падеж (Число)  – номер відмінка (1–7, аналогічно ПолучитьМесяц).
//
// Повертає:
//   Рядок – назва місяця у заданому відмінку.
//
// Виключення:
//   Не генерує виключень.
//
// Особливості:
//   Метод виконується на сервері без контексту.
//
Функция ПолучитьМесяцПоДате(Дата, Падеж) Экспорт

	// Масив називних форм у порядку місяців (індекс 1–12)
	НазвиМісяців = Новый Массив;
	НазвиМісяців.Добавить("січень");   // 1
	НазвиМісяців.Добавить("лютий");    // 2
	НазвиМісяців.Добавить("березень"); // 3
	НазвиМісяців.Добавить("квітень");  // 4
	НазвиМісяців.Добавить("травень");  // 5
	НазвиМісяців.Добавить("червень");  // 6
	НазвиМісяців.Добавить("липень");   // 7
	НазвиМісяців.Добавить("серпень");  // 8
	НазвиМісяців.Добавить("вересень"); // 9
	НазвиМісяців.Добавить("жовтень");  // 10
	НазвиМісяців.Добавить("листопад"); // 11
	НазвиМісяців.Добавить("грудень");  // 12

	НомерМісяця = Месяц(Дата);
	НаименованиеМесяца = НазвиМісяців[НомерМісяця - 1];

	Возврат ПолучитьМесяц(НаименованиеМесяца, Падеж);

КонецФункции


