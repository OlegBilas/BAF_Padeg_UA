
#Область СклонениеСтроки

////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ: ПолучитьСклоненияСтрокиУкр
// ================================================================================
// Призначення:
//   Відмінювання українських ПІБ, посад та загальних слів по 7 відмінках.
//   Переписано з Turbo Delphi (Padeg_ua.dll, автор Тарасенков В.М.) мовою 1С.
//
// Відмінки (НомерПадежа):
//   1 - Називний   (Хто? Що?)       → Іваненко Петро Миколайович
//   2 - Родовий    (Кого? Чого?)    → Іваненка Петра Миколайовича
//   3 - Давальний  (Кому? Чому?)    → Іваненку Петру Миколайовичу
//   4 - Знахідний  (Кого? Що?)      → Іваненка Петра Миколайовича
//   5 - Орудний    (Ким? Чим?)      → Іваненком Петром Миколайовичем
//   6 - Місцевий   (На кому?)       → Іваненку Петру Миколайовичу
//   7 - Кличний    (Звертання)      → Іваненку Петре Миколайовичу
//
// Стать (Пол):
//   "М" або "Ч" → Чоловіча
//   "Ж"         → Жіноча
//   ""          → Визначається автоматично по-батькові
//
// Публічний API:
//   ПолучитьФИО(Фамилия, Имя, Отчество, Пол, НомерПадежа) Экспорт
//   ПолучитьФИОСтрокой(ФИО, Пол, НомерПадежа) Экспорт
//   ПолучитьФИОАвтоПол(ФИО, НомерПадежа) Экспорт
//   ПолучитьИО(Имя, Фамилия, Пол, НомерПадежа) Экспорт
//   ОпределитьПол(Отчество) Экспорт
//   РазделитьФИО(ФИО, Фамилия, Имя, Отчество) Экспорт
//   ПолучитьДолжность(Должность, НомерПадежа) Экспорт
//   ПолучитьПолнуюДолжность(Должность, Отдел, НомерПадежа) Экспорт
//   ПолучитьМесяц(НаименованиеМесяца, Падеж) Экспорт
//   ПолучитьМесяцПоДате(Дата, Падеж) Экспорт
// ================================================================================

#Область ЭкспортныеФункцииВызова


// ------------------------------------------------------------------------------------------------
// Функция ПолучитьФИО
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює ПІБ (прізвище, ім'я, по-батькові) по заданому відмінку.
//   Еквівалент GetFIOPadeg з Padeg_ua.dll.
//
// Параметри:
//   Фамилия    (Строка) – прізвище.
//   Имя        (Строка) – ім'я.
//   Отчество   (Строка) – по-батькові.
//   Пол        (Строка) – "М"/"Ч" = чоловічий, "Ж" = жіночий, "" = авто по по-батькові.
//   НомерПадежа (Число) – відмінок 1..7.
//
// Повертає:
//   Строка – повне ПІБ у заданому відмінку.
//
// Виключення:
//   Не генерує. При невизначеній формі повертає вхідний текст.
// ------------------------------------------------------------------------------------------------
Функция ПолучитьФИО(Фамилия, Имя, Отчество, Пол, НомерПадежа) Экспорт

	// Визначаємо стать якщо не задана
	НормПол = НРег(Пол);
	Если НормПол = "м" ИЛИ НормПол = "ч" Тогда
		РобочийПол = "Ч";
	ИначеЕсли НормПол = "ж" Тогда
		РобочийПол = "Ж";
	Иначе
		// Авто-визначення по по-батькові
		РобочийПол = _ОпределитьПолПоОтчеству(Отчество);
		Если ПустаяСтрока(РобочийПол) Тогда
			РобочийПол = "Ч"; // за замовчуванням
		КонецЕсли;
	КонецЕсли;

	Результат = "";

	// Відмінюємо прізвище
	Если НЕ ПустаяСтрока(СокрЛП(Фамилия)) Тогда
		ВідмФамілія = _ПолучитьЧасть(СокрЛП(Фамилия), РобочийПол, НомерПадежа, "Фамилия");
		Если НЕ ПустаяСтрока(ВідмФамілія) Тогда
			Результат = ВідмФамілія;
		КонецЕсли;
	КонецЕсли;

	// Відмінюємо ім'я (тільки якщо є повне, не ініціал)
	Если НЕ ПустаяСтрока(СокрЛП(Имя)) Тогда
		ВідмІмя = _ПолучитьЧасть(СокрЛП(Имя), РобочийПол, НомерПадежа, "Имя");
		Если НЕ ПустаяСтрока(ВідмІмя) Тогда
			Если НЕ ПустаяСтрока(Результат) Тогда
				Результат = Результат + " ";
			КонецЕсли;
			Результат = Результат + ВідмІмя;
		КонецЕсли;
	КонецЕсли;

	// Відмінюємо по-батькові (тільки якщо є повне, не ініціал)
	Если НЕ ПустаяСтрока(СокрЛП(Отчество)) Тогда
		ВідмПоБат = _ПолучитьЧасть(СокрЛП(Отчество), РобочийПол, НомерПадежа, "Отчество");
		Если НЕ ПустаяСтрока(ВідмПоБат) Тогда
			Если НЕ ПустаяСтрока(Результат) Тогда
				Результат = Результат + " ";
			КонецЕсли;
			Результат = Результат + ВідмПоБат;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции


// ------------------------------------------------------------------------------------------------
// Функция ПолучитьФИОСтрокой
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює ПІБ, передане одним рядком (прізвище ім'я по-батькові).
//   Еквівалент GetFIOPadegFS з Padeg_ua.dll.
//
// Параметри:
//   ФИО         (Строка) – повне ПІБ через пробіл.
//   Пол         (Строка) – стать: "М"/"Ч", "Ж" або "" (авто).
//   НомерПадежа (Число)  – відмінок 1..7.
//
// Повертає:
//   Строка – ПІБ у заданому відмінку.
// ------------------------------------------------------------------------------------------------
Функция ПолучитьФИОСтрокой(ФИО, Пол, НомерПадежа) Экспорт

	Фамилия  = "";
	Имя      = "";
	Отчество = "";
	РазделитьФИО(ФИО, Фамилия, Имя, Отчество);

	Возврат ПолучитьФИО(Фамилия, Имя, Отчество, Пол, НомерПадежа);

КонецФункции


