// ------------------------------------------------------------------------------------------------
// Функция ОпределитьПол
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Визначає стать особи по по-батькові.
//   Аналіз закінчення: -ович/-йович = чоловічий, -івна/-овна = жіночий.
//   Еквівалент GetSex з Padeg_ua.dll.
//
// Параметри:
//   Отчество (Строка) – по-батькові.
//
// Повертає:
//   Число – 1 (чоловічий), 0 (жіночий), -1 (невизначено).
// ------------------------------------------------------------------------------------------------
Функция ОпределитьПол(Отчество) Экспорт

	Пол = _ОпределитьПолПоОтчеству(Отчество);

	Если Пол = "Ч" Тогда
		Возврат 1;
	ИначеЕсли Пол = "Ж" Тогда
		Возврат 0;
	Иначе
		Возврат -1;
	КонецЕсли;

КонецФункции


// ------------------------------------------------------------------------------------------------
// Процедура РазделитьФИО
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Розбиває рядок ПІБ на складові: прізвище, ім'я, по-батькові.
//   Порядок: Прізвище Ім'я По-батькові.
//   Еквівалент SeparateFIO з Padeg_ua.dll.
//
// Параметри:
//   ФИО      (Строка)     – повний ПІБ через пробіл.
//   Фамилия  (Строка)     – [out] прізвище (не обов'язкове).
//   Имя      (Строка)     – [out] ім'я (не обов'язкове).
//   Отчество (Строка)     – [out] по-батькові (не обов'язкове).
//
// Повертає:
//   Нічого (через параметри).
// ------------------------------------------------------------------------------------------------
Процедура РазделитьФИО(ФИО, Фамилия = "", Имя = "", Отчество = "") Экспорт


	Рядок = СокрЛП(ФИО);
	Если ПустаяСтрока(Рядок) Тогда
		Возврат;
	КонецЕсли;

	Поз = СтрНайти(Рядок, " ");
	Если Поз > 0 Тогда
		Фамилия = СокрЛП(Лев(Рядок, Поз - 1));
		Залишок = СокрЛП(Сред(Рядок, Поз + 1));
		Поз2 = СтрНайти(Залишок, " ");
		Если Поз2 > 0 Тогда
			Имя      = СокрЛП(Лев(Залишок, Поз2 - 1));
			Отчество = СокрЛП(Сред(Залишок, Поз2 + 1));
		Иначе
			Имя = Залишок;
		КонецЕсли;
	Иначе
		Фамилия = Рядок;
	КонецЕсли;

КонецПроцедуры


// ------------------------------------------------------------------------------------------------
// Функция ПолучитьДолжность
// ------------------------------------------------------------------------------------------------
// Призначення:
//   Відмінює назву посади по заданому відмінку.
//   Обробляє складні посади (кілька слів).
//   Еквівалент GetAppointmentPadeg з Padeg_ua.dll.
//
// Параметри:
//   Должность   (Строка) – назва посади.
//   НомерПадежа (Число)  – відмінок 1..7.
//
// Повертає:
//   Строка – посада у заданому відмінку.
//
// Особливості:
//   Відмінюється лише ПЕРШЕ слово посади (головний іменник).
//   Виняток: якщо перше слово є прикметником (закінчення -ий/-ій), то
//   разом з ним відмінюється і ДРУГЕ слово (іменник, якому підпорядкований прикметник).
//   Решта слів (від третього і далі) залишаються незмінними.
//   Правило відповідає нормам ділового мовлення:
//     "начальника відділу кадрів"           ← одне слово
//     "головного бухгалтера"                 ← прикметник + іменник
//     "старшого менеджера з продажу"         ← прикметник + іменник + решта без змін
// ------------------------------------------------------------------------------------------------
Функция ПолучитьДолжность(Должность, НомерПадежа) Экспорт

	Если ПустаяСтрока(СокрЛП(Должность)) Тогда
		Возврат Должность;
	КонецЕсли;

	Слова = СтрРазделить(СокрЛП(Должность), " ", Ложь);

	ПершеСлово    = Слова[0];
	ВідмПершеСлово = _ПолучитьФрагментДолжности(ПершеСлово, НомерПадежа);

	Результат = ВідмПершеСлово;

	// Визначаємо: чи є перше слово прикметником (закінчення -ий/-ій)?
	// Якщо так — відмінюємо також друге слово (іменник-головне слово групи).
	ПершеМал = НРег(ПершеСлово);
	ЦеПрикметник = СтрДлина(ПершеМал) >= 3
		И (Прав(ПершеМал, 2) = "ий" ИЛИ Прав(ПершеМал, 2) = "ій");

	ПочатокРешти = 1; // індекс першого слова, яке не відмінюється

	Если ЦеПрикметник И Слова.Количество() >= 2 Тогда
		// Відмінюємо також друге слово (іменник)
		ВідмДругеСлово = _ПолучитьФрагментДолжности(Слова[1], НомерПадежа);
		Результат      = Результат + " " + ВідмДругеСлово;
		ПочатокРешти   = 2;
	КонецЕсли;

	// Решта слів — без змін
	Для і = ПочатокРешти По Слова.Количество() - 1 Цикл
		Результат = Результат + " " + Слова[і];
	КонецЦикла;

	Возврат Результат;

КонецФункции


